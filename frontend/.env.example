# AWS Configuration - Values from CDK deployment outputs
NEXT_PUBLIC_API_URL=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com/prod
NEXT_PUBLIC_USER_POOL_ID=us-east-1_XXXXXXXX
NEXT_PUBLIC_USER_POOL_CLIENT_ID=your-client-id
NEXT_PUBLIC_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_AGENTCORE_WS_URL=wss://bedrock-agentcore.us-east-1.amazonaws.com/runtimes/arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/your-runtime-id/ws
NEXT_PUBLIC_AWS_REGION=us-east-1

# ──────────────────────────────────────────────────────────
# Voice Agent Configuration
# ──────────────────────────────────────────────────────────

# Anam AI Avatar (primary - video avatar with lip sync)
# Set to 'true' when ANAM_API_KEY is configured in Lambda
# If 'false' or not set, falls back to Nova Sonic voice-only mode
NEXT_PUBLIC_ANAM_ENABLED=true

# Nova Sonic Voice Agent (fallback - AWS native speech-to-speech)
# Always enabled by default, used when Anam is unavailable
NEXT_PUBLIC_NOVA_SONIC_ENABLED=true
