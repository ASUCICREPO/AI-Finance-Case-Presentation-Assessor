        <!-- Amazon Transcribe (browser-side streaming for presentation captions) -->
        <mxCell id="transcribe" value="Amazon Transcribe&#10;(streaming, browser-side)&#10;presentation captions" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#116D5B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transcribe;" vertex="1" parent="1">
          <mxGeometry x="55" y="600" width="60" height="60" as="geometry" />
